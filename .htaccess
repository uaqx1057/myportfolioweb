AddDefaultCharset UTF-8
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Do not expose source, build tools, dependencies, local environments or config.
    RewriteRule ^(?:content|tools|tests|tmp|build|vendor|node_modules|\.venv|\.git|\.github|\.config)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:plan\.md|AGENTS\.md|CLAUDE\.md|README\.md|DEPLOYMENT\.md|requirements\.txt|package(?:-lock)?\.json|composer\.(?:json|lock)|mail-config\.example\.php|contact-config\.php|\.env.*)$ - [F,L,NC]

    # Avoid duplicate index.html URLs, without redirecting internal directory indexes.
    RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[?\s]) [NC]
    RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

    RewriteCond %{HTTP_HOST} ^(codewithusman\.com|www\.codewithusman\.com|usman\.dobs\.cloud|www\.usman\.dobs\.cloud)$ [NC]
    RewriteCond %{HTTP_HOST} !^www\.codewithusman\.com$ [NC,OR]
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://www.codewithusman.com%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType "text/html; charset=UTF-8" .html .htm
    AddCharset UTF-8 .html .htm .css .js .json .xml .txt
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresDefault "access plus 7 days"
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    <FilesMatch "\.(css|js|svg|ico|png|jpe?g|webp)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(pdf|txt|xml)$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>
